# PORT is what the production server listens on (also read by start.js's
# fuser port-kill). Same value on every machine.
PORT=8060

# DATA_DIR is the one setting that differs by machine — a Windows UNC path
# on the dev machine, a Linux mount path in production. `.env` holds the
# dev-machine default (read directly by `vite dev` and local
# `npm run start`); `.env.production` overrides just this one line for the
# production host. Both files are committed — see start.js / apps.json,
# which load `.env` then `.env.production` in that order so the second
# file's DATA_DIR wins. Never needs hand-editing after initial setup on
# either machine.
DATA_DIR=

# Set to 1 to block all mutating API routes (assertWritable() in
# src/lib/server/assert-writable.ts) while still serving reads — used to
# safely point this app at a live data share you don't want to risk
# writing to (e.g. verifying against production data before a cutover).
# Leave unset for normal read-write operation.
READ_ONLY=
